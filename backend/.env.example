# Exemplo; mantenha suas credenciais reais somente no .env (ignorado pelo Git).
DB_NAME=integrador
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
PORT=3001
# Gere a chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRACAO_SEGUNDOS=3600
CORS_ORIGIN=http://localhost:5173
REPRO_DIAS_GESTACAO=280
REPRO_DIAS_ANTES_PARTO_SECAGEM=60
REPRO_DIAS_DIAGNOSTICO_MIN=28
REPRO_DIAS_DIAGNOSTICO_MAX=35
REPRO_IDADE_PRIMEIRA_INSEMINACAO_MESES=15
REPRO_INTERVALO_POS_PARTO_DIAS=60
# Opcional: diretório persistente para documentos (padrão uploads/documentos).
# DOCUMENTOS_DIR=/caminho/privado/documentos
